# === TVMbot v4 Environment ===

# Local Hermes Agent harness (API server stays on VPS loopback)
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-a-long-random-secret
HERMES_API_MODEL=tvm
HERMES_API_TIMEOUT_MS=120000

# Notion
NOTION_TOKEN=ntn_...
NOTION_TASKS_DB=        # Tasks database ID
NOTION_PAYMENTS_DB=     # Monthly Payments database ID
NOTION_PROJECTS_DB=     # Projects database ID

# Telegram
TELEGRAM_BOT_TOKEN=     # From @BotFather

# WhatsApp
WA_SESSION_PATH=./wa-session  # Baileys session directory

# Users (phone numbers without +)
AFNI_PHONE=6282122922252
SYIFA_PHONE=6287750590799
AFNI_TELEGRAM_ID=       # Telegram chat ID for Afni
SYIFA_TELEGRAM_ID=      # Telegram chat ID for Syifa

# Timezone
TZ=Asia/Makassar

# Protected Admin HQ
ADMIN_USERNAME=afni
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
PORT=3000
# Local integration tests only; leave unset in production.
DISABLE_CHANNELS=false

# Google Workspace — private OAuth integration (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY= # generate with: openssl rand -base64 32
GOOGLE_ALLOWED_EMAIL=info@thevillamanagers.com
GOOGLE_OAUTH_REDIRECT_URI=https://thevillamanagers.cloud/admin/integrations/google/callback
